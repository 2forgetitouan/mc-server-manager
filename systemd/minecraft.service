# =============================================================================
# Minecraft Server (Fabric) - systemd service
# =============================================================================
# Managed by mc-server-manager.
# Install with:  sudo mc service install
#   or manually: sudo cp minecraft.service /etc/systemd/system/
#                sudo systemctl daemon-reload
#                sudo systemctl enable minecraft
#
# Memory, java path, and jar are configured in /etc/mc/config.toml.
# After changing them, regenerate the override file with:
#   sudo mc service generate-env
# then restart: mc restart
# =============================================================================

[Unit]
Description=Minecraft Server (Fabric)
# Wait for the network to be online before starting.
After=network.target
# Circuit breaker: allow at most 3 automatic restarts within a 5-minute window.
# This prevents the service from restarting in an infinite loop on fatal errors.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# --- Identity ----------------------------------------------------------------
# Run as the dedicated minecraft user; never as root.
User=ubuntu
WorkingDirectory=/home/ubuntu/minecraft

# --- Default settings --------------------------------------------------------
# NOTE: systemd expands ${VAR} only for arguments, NOT for the executable path.
# The java binary must therefore be a literal path. /usr/bin/java is managed by
# update-alternatives on Ubuntu - use `sudo update-alternatives --config java`
# to switch JDK versions.
Environment=MC_JAR=server.jar
Environment=MC_MIN_MEMORY=-Xms2G
Environment=MC_MAX_MEMORY=-Xmx8G

# --- Config overrides --------------------------------------------------------
# Generated by 'sudo mc service generate-env' from /etc/mc/config.toml.
# The leading '-' makes the file optional: the service starts with the
# Environment= defaults above if the file does not exist yet.
EnvironmentFile=-/etc/mc/minecraft.env

# --- Execution ---------------------------------------------------------------
# ${MC_MIN_MEMORY}, ${MC_MAX_MEMORY}, ${MC_JAR} are in argument positions and
# are expanded correctly by systemd.
ExecStart=/usr/bin/java \
    ${MC_MIN_MEMORY} \
    ${MC_MAX_MEMORY} \
    -XX:+UseG1GC \
    -XX:+ParallelRefProcEnabled \
    -XX:MaxGCPauseMillis=200 \
    -XX:+UnlockExperimentalVMOptions \
    -XX:+DisableExplicitGC \
    -XX:+AlwaysPreTouch \
    -XX:G1NewSizePercent=30 \
    -XX:G1MaxNewSizePercent=40 \
    -XX:G1HeapRegionSize=8M \
    -XX:G1ReservePercent=20 \
    -XX:G1MixedGCCountTarget=4 \
    -XX:InitiatingHeapOccupancyPercent=15 \
    -XX:G1MixedGCLiveThresholdPercent=90 \
    -XX:G1RSetUpdatingPauseTimePercent=5 \
    -XX:SurvivorRatio=32 \
    -XX:+PerfDisableSharedMem \
    -XX:MaxTenuringThreshold=1 \
    -Dusing.aikars.flags=https://mcflags.emc.gs \
    -Daikars.new.flags=true \
    -jar ${MC_JAR} --nogui

# --- Logging -----------------------------------------------------------------
# Send stdout/stderr to the systemd journal for unified log management.
StandardOutput=journal
StandardError=journal
# Tag journal entries so they can be filtered with: journalctl -u minecraft
SyslogIdentifier=minecraft

# --- Restart policy ----------------------------------------------------------
# Restart only on non-zero exit (crash); do not restart on clean shutdown.
Restart=on-failure
# Wait 30 seconds before restarting to give the system time to recover.
RestartSec=30

# --- Shutdown behaviour ------------------------------------------------------
# Minecraft needs time to save chunks and player data before stopping.
# 90 seconds is generous but avoids data loss on large worlds.
TimeoutStopSec=90
# Send SIGTERM so the JVM can trigger a graceful shutdown hook.
KillSignal=SIGTERM

# --- Security hardening ------------------------------------------------------
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/minecraft
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
